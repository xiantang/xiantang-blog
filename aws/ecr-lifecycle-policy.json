{
  "rules": [
    {
      "rulePriority": 1,
      "description": "untagged 镜像 1 天后清理。CI 不再推 latest 之后这条基本不会命中，留着兜底。",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 2,
      "description": "sha- 标签只保留最近 20 个，即约 20 次提交的回滚窗口。",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["sha-"],
        "countType": "imageCountMoreThan",
        "countNumber": 20
      },
      "action": { "type": "expire" }
    }
  ]
}
